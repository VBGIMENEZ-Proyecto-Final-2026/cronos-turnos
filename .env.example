# Copiar a .env (ignorado por git) y completar con los valores reales.
# Los valores salen de la respuesta de POST /api/student/register (campo
# "integration") y de GET /api/student/integration. Nunca commitear valores reales.
# Mismo set de variables CATEDRA_* en atlas-catalogo y cronos-turnos.

# --- Cátedra: cuenta técnica ---
CATEDRA_REST_BASE_URL=http://<host>:<puerto>
CATEDRA_ID_TOKEN=<id_token>
CATEDRA_GROUP_ID=<groupId>

# --- Redis (lectura: catedra:sync:*) ---
CATEDRA_REDIS_HOST=<redisHost>
CATEDRA_REDIS_PORT=<redisPort>
CATEDRA_REDIS_USERNAME=<redisUsername>
CATEDRA_REDIS_PASSWORD=<redisPassword>
CATEDRA_REDIS_READ_NAMESPACE=catedra:sync:*
CATEDRA_REDIS_WRITE_NAMESPACE=alumnos:<groupId>:*

# --- Kafka ---
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=<kafkaBootstrapServers>
CATEDRA_KAFKA_CATALOG_TOPIC=catedra.catalog.<groupId>
CATEDRA_KAFKA_CONSUMER_GROUP_ID=alumnos-<groupId>
CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC=alumnos.turnos.acciones.<groupId>
CATEDRA_KAFKA_APPOINTMENT_PHONE_TOPIC=catedra.turnos.telefono.<groupId>

# --- Base de datos local (cronos) ---
CRONOS_DB_HOST=localhost
CRONOS_DB_PORT=5434
CRONOS_DB_NAME=cronos
CRONOS_DB_USER=cronos
CRONOS_DB_PASSWORD=<password>

# --- Servicio ---
# Puerto HTTP de cronos (atlas usa 8080).
CRONOS_SERVER_PORT=8081

# --- JWT de los usuarios (cronos firma con RS256; atlas valida con la clave pública) ---
# Clave PRIVADA RSA en PEM PKCS#8 (-----BEGIN PRIVATE KEY-----), de al menos 2048 bits. Definir solo UNA de las dos.
# Sin clave, cronos no arranca. Nunca commitear la clave. Para desarrollo local ver "Usuarios" en el README.
CRONOS_JWT_PRIVATE_KEY_LOCATION=<ruta/a/la/clave-privada.pem>
# CRONOS_JWT_PRIVATE_KEY=<PEM en una línea, con \n literales>
# Vigencia del token: normal y con rememberMe (opcionales; por defecto 1h y 30d).
# CRONOS_JWT_TTL=1h
# CRONOS_JWT_REMEMBER_ME_TTL=30d
# Tolerancia de reloj al validar el vencimiento de los tokens recibidos (0 a 5 minutos; por defecto 60s).
# CRONOS_JWT_CLOCK_SKEW=60s

# --- CORS ---
# Orígenes que pueden llamar a la API desde un navegador, separados por coma (esquema://host[:puerto], sin
# comodines ni rutas). Vacío = ninguno. La app Android no es un navegador y no lo necesita.
# CRONOS_CORS_ALLOWED_ORIGINS=https://app.ejemplo.test

# --- Atlas (catálogo) ---
# Dónde está atlas-catalogo. Cronos le reenvía el JWT del usuario: no tiene credencial propia (ADR 0004).
# ATLAS_BASE_URL=http://localhost:8080
# Timeouts y reintentos (opcionales; por defecto 2s, 5s y 1; los reintentos van de 0 a 5).
# ATLAS_CONNECT_TIMEOUT=2s
# ATLAS_READ_TIMEOUT=5s
# ATLAS_MAX_RETRIES=1

# --- Disponibilidad ---
# Zona de las horas locales del consultorio (los horarios no traen zona): decide qué turnos ya empezaron.
# CRONOS_CLINIC_ZONE=America/Argentina/Buenos_Aires
# Rango de fechas más largo que se acepta, contando ambos extremos (1 a 366; por defecto 31).
# CRONOS_AVAILABILITY_MAX_RANGE_DAYS=31
# Cliente de la cátedra (opcionales; por defecto 3s, 10s y 1): CATEDRA_REST_CONNECT_TIMEOUT,
# CATEDRA_REST_READ_TIMEOUT y CATEDRA_REST_MAX_RETRIES.

# Consumidor de Kafka (resultados de las reservas). Usa CATEDRA_KAFKA_BOOTSTRAP_SERVERS, CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC
# y CATEDRA_KAFKA_CONSUMER_GROUP_ID: cronos consume con el grupo "<ese grupo>-cronos" (propio, no comparte offsets con atlas).
# Todos opcionales: CRONOS_KAFKA_CONSUMER_ENABLED (true; false apaga el consumidor y no exige la configuración de Kafka),
# CRONOS_KAFKA_AUTO_OFFSET_RESET (earliest), CRONOS_KAFKA_START_RETRY_INTERVAL (10s), CRONOS_KAFKA_UNKNOWN_PROCESS_ATTEMPTS (3),
# CRONOS_KAFKA_PROCESSING_ATTEMPTS (3), CRONOS_KAFKA_RETRY_DELAY (1s), CRONOS_KAFKA_RETRY_MULTIPLIER (2.0) y
# CRONOS_KAFKA_RETRY_MAX_DELAY (30s) y CRONOS_KAFKA_IDLE_EVENT_INTERVAL (30s: cada cuánto se avisa que no hay particiones).
